{
  "name": "imizamo-yethu-aftercare",
  "version": "1.0.0",
  "private": true,
  "description": "Imizamo Yethu Aftercare Management System (INSY7315 Part 2 Prototype)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build:client": "npm run build --workspace client",
    "build:deploy": "node scripts/build-deploy.mjs",
    "start:server": "npm run start --workspace server",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace server",
    "test:client": "npm run test --workspace client",
    "test:coverage": "npm run test:coverage --workspace server && npm run test:coverage --workspace client",
    "seed:demo": "npm run seed:demo --workspace server --",
    "test:e2e": "node e2e/prepare.mjs && playwright test --config e2e/playwright.config.js",
    "test:e2e:report": "playwright show-report e2e/playwright-report"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.2.2"
  }
}
