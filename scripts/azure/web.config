<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure Web App (Windows): IIS runs Node through iisnode. Every request is
  handed to start.cjs, and Express serves both /api and the React app.
  Copied into the deploy package by scripts/build-deploy.mjs.
  (A Linux Web App ignores this file and runs "npm start" instead.)
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="start.cjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="AllToNode">
          <action type="Rewrite" url="start.cjs" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- Let Express send its own error pages and JSON errors. -->
    <httpErrors existingResponse="PassThrough" />
    <iisnode loggingEnabled="true" devErrorsEnabled="false" />
  </system.webServer>
</configuration>
