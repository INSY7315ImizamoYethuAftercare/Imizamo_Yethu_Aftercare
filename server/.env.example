# Copy to .env (already gitignored) and fill in real values locally.
# In Azure, these are set via App Service > Configuration > Application
# settings (task #10) — never commit a real .env file.

NODE_ENV=development
PORT=4000

# Must match the client's dev URL so CORS allows the cookie-based auth
# flow (credentials: true) to work.
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:Aftercare2345@localhost:5432/imizamo_dev 

# Set to true when DATABASE_URL points at Azure PostgreSQL (it requires SSL).
# Use this instead of NODE_ENV=production on your own machine, because
# production also makes the login cookie HTTPS-only and it won't be set on
# http://localhost.
#DB_SSL=false

JWT_SECRET=e6540c0cc5cd31fecb6203c95a560415465bf37905b8bf57638446db83d63a37
