# Copy to .env.local (already gitignored) and adjust for your machine.
# Vite only exposes variables prefixed with VITE_ to client-side code —
# never put secrets here, this bundle is public.

# Leave unset to use the Vite dev proxy (see vite.config.js) which forwards
# /api/* to the local Express server. Set this only for pointing at a
# deployed API instead.
# VITE_API_BASE_URL=/api
